# Chip configuration — copy to .env and fill in. NEVER commit .env.

# Model API keys
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# signal-cli daemon (JSON-RPC unix socket is the primary path; see SIGNAL_SOCKET
# default /run/signal-cli/signal.sock in coordinator.py)
SIGNAL_API_URL=http://localhost:8080

# Ollama (local router/embedding models)
OLLAMA_API_URL=http://localhost:11434

# The bot's own Signal number
SENDER_NUMBER=+15550100000

# Optional: Fernet key for encrypting archived conversation buffers
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DREAM_ENCRYPT_KEY=

# Default weather/location context (also settable in config/users.json)
CHIP_HOME_LOCATION=Springfield,IL

# Users, personas, and household context live in config/users.json —
# copy config/users.example.json and edit. That file is gitignored.

# Where this checkout lives (cron/systemd must also set it; see README)
CHIP_WORKSPACE=/opt/chip
